# ── Application ───────────────────────────────────────────────
APP_NAME="Autonomous AI Data Analyst"
ENVIRONMENT=development

# ── Security ──────────────────────────────────────────────────
SECRET_KEY=please-change-this-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Application database (PostgreSQL) ─────────────────────────
APP_DATABASE_URL=postgresql+psycopg2://ai_analyst:ai_analyst_pass@localhost:5432/ai_analyst
# Zero-setup alternative (no PostgreSQL install needed):
# APP_DATABASE_URL=sqlite:///./ai_analyst.db


# ── LLM engine (Ollama) ───────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=hf.co/Qwen/Qwen2.5-0.5B-Instruct-GGUF:Q4_K_M
LLM_TEMPERATURE=0.1
LLM_NUM_CTX=8192
LLM_MAX_ATTEMPTS=3

# ── Query guardrails ──────────────────────────────────────────
SQL_ROW_LIMIT=1000
CHART_ROW_LIMIT=500
TABLE_PREVIEW_ROWS=100

# ── Bootstrap admin (created on first startup) ────────────────
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=ChangeMe123!

# ── CORS — the Next.js dev server only ────────────────────────
CORS_ORIGINS=http://localhost:3000
